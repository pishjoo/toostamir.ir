# ============================================================
#.htaccess — فقط اگر سایت را با دامنه toostamir.ir در public_html سرو می‌کنید
# و اپ Node.js روی پورت 3000 اجراست (پروکسی به Node).
# اگر از «Subdomain → Application Root» cPanel استفاده می‌کنید،
# معمولاً نیازی به این فایل نیست.
# ============================================================
Options +FollowSymLinks
RewriteEngine On

# هدایت به HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# پروکسی همه درخواست‌ها به اپ Node.js روی پورت 3000
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
