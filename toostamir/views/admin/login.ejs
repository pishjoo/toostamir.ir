<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ورود مدیریت | تعمیرامیر</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body class="login-body">
  <form method="post" action="/admin/login" class="login-card">
    <h1>🔧 پنل مدیریت تعمیرامیر</h1>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <label>نام کاربری<input type="text" name="username" required autofocus></label>
    <label>رمز عبور<input type="password" name="password" required></label>
    <button class="btn" type="submit">ورود</button>
    <a href="/" class="back">→ بازگشت به سایت</a>
  </form>
</body>
</html>
