<%- include('header') %>
<div class="page-head-admin"><h1>پیام‌های فرم تماس</h1></div>

<div class="panel">
  <% if (messages.length === 0) { %>
    <div class="empty">هنوز پیامی ثبت نشده است. پیام‌های فرم تماس اینجا نمایش داده می‌شوند.</div>
  <% } else { %>
    <% messages.forEach(m => { %>
    <div class="msg-card <%= m.status === 'new' ? 'unread' : '' %>">
      <div class="msg-head">
        <b><%= m.name %></b>
        <span class="phone">📞 <%= m.phone %></span>
        <% if (m.email) { %><span>✉️ <%= m.email %></span><% } %>
        <span class="date"><%= m.created_at %></span>
        <span class="pill <%= m.status === 'new' ? 'off' : 'ok' %>"><%= m.status === 'new' ? 'جدید' : 'خوانده‌شده' %></span>
      </div>
      <% if (m.subject) { %><div class="msg-subject">موضوع: <%= m.subject %></div><% } %>
      <p class="msg-body"><%= m.message %></p>
      <div class="msg-actions">
        <% if (m.status === 'new') { %>
        <form method="post" action="/admin/messages/<%= m.id %>?_method=PATCH">
          <input type="hidden" name="status" value="read">
          <button class="btn btn-sm btn-outline" type="submit">✓ خوانده شد</button>
        </form>
        <% } %>
        <form method="post" action="/admin/messages/<%= m.id %>?_method=DELETE" onsubmit="return confirm('حذف پیام؟')">
          <button class="btn btn-sm danger" type="submit">حذف</button>
        </form>
      </div>
    </div>
    <% }) %>
  <% } %>
</div>
<%- include('footer') %>
