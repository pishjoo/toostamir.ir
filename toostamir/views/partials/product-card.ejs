<%# Product card partial - expects `p` (product object) %>
<div class="card">
  <a href="/product/<%= p.id %>" class="card-img">
    <% if (p.image) { %>
      <img src="<%= p.image %>" alt="<%= p.name %>">
    <% } else { %>
      <div class="placeholder" aria-label="تصویر محصول">
        <span>🖼️</span>
        <small>به‌زودی</small>
      </div>
    <% } %>
    <% if (p.old_price > p.price && p.price > 0) { %><span class="badge-sale">تخفیف</span><% } %>
    <% if (p.category.includes('تعمیر')) { %><span class="badge-service">خدمات</span><% } %>
  </a>
  <div class="card-body">
    <div class="cat"><%= p.category %></div>
    <a href="/product/<%= p.id %>"><h3><%= p.name %></h3></a>
    <p class="short"><%= p.short_desc %></p>
    <div class="price-row">
      <% if (p.price > 0) { %>
        <span class="price"><%= toman(p.price) %> تومان</span>
        <% if (p.old_price > p.price) { %><span class="old"><%= toman(p.old_price) %></span><% } %>
      <% } else { %>
        <span class="price consult">استعلام تلفنی</span>
      <% } %>
    </div>
    <div class="card-actions">
      <a class="btn btn-sm" href="/product/<%= p.id %>">جزئیات</a>
      <a class="btn btn-outline btn-sm" href="/contact">استعلام / سفارش</a>
    </div>
  </div>
</div>
