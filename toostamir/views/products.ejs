<%- include('partials/header') %>

<section class="page-head">
  <div class="container">
    <h1>محصولات و خدمات</h1>
    <p>قیمت‌ها تقریبی است؛ برای اطمینان از موجودی و قیمت روز، <strong>استعلام تلفنی</strong> نمایید.</p>
  </div>
</section>

<div class="container section">
  <form class="filter-bar" method="get" action="/products">
    <input type="text" name="q" placeholder="جستجوی محصول..." value="<%= q %>">
    <select name="cat">
      <option value="">همه دسته‌ها</option>
      <% categories.forEach(c => { %>
        <option value="<%= c %>" <%= cat === c ? 'selected' : '' %>><%= c %></option>
      <% }) %>
    </select>
    <button class="btn" type="submit">فیلتر</button>
  </form>

  <% if (products.length === 0) { %>
    <div class="empty">محصولی یافت نشد. از پنل مدیریت محصول اضافه کنید.</div>
  <% } else { %>
    <div class="grid">
      <% products.forEach(p => { %>
        <%- include('partials/product-card', { p }) %>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
