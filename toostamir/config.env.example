# ============================================================
# تنظیمات اتصال به دیتابیس MariaDB/MySQL هاست اشتراکی (cPanel)
# این فایل را در cPanel > File Manager در پوشه پروژه قرار دهید.
# ------------------------------------------------------------
# در cPanel:
#   1) از بخش MySQL Databases یک دیتابیس و یک یوزر بسازید
#      (نام‌ها معمولاً با پیشوند حساب شما مثل cpses_xxx یا uXXXX_ ذخیره می‌شوند).
#   2) یوزر را روی دیتابیس Add کنید و ALL PRIVILEGES بدهید.
#   3) مقادیر زیر را با اطلاعات خودتان جایگزین کنید.
# نکته: charset سرور شما cp1252 است؛ کد به‌صورت خودکار روی
#       utf8mb4 تنظیم می‌کند تا فارسی‌ها درست ذخیره شوند.
# ============================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpanelUser_toostamir
DB_USER=cpanelUser_admin
DB_PASS=YOUR_DB_PASSWORD_HERE

# راز سشن (یک رشته تصادفی طولانی بگذارید)
SESSION_SECRET=change-me-to-a-long-random-string

# پورت اپ Node.js در cPanel (معمولاً 3000)
PORT=3000
